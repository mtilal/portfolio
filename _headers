# Cloudflare Pages applies these response headers. GitHub Pages ignores the
# file, which is harmless.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Assets have no content hash in their names, so cache hard at the edge but
# let the browser revalidate daily — a replaced CV or photo appears without a
# forced refresh.
/assets/*
  Cache-Control: public, max-age=86400, s-maxage=31536000

# The HTML must always revalidate, or your edits won't show.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
